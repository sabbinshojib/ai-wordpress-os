{
	"name": "ai-wordpress-os/ai-wordpress-os",
	"description": "An AI-native operating system for WordPress: MCP server, permission engine, approval queue, audit trail and tool catalog.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"authors": [
		{
			"name": "AI WordPress OS"
		}
	],
	"require": {
		"php": ">=8.2",
		"composer/installers": "^2.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"phpstan/phpstan": "^1.11",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"php-stubs/wordpress-stubs": "^6.5",
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"AIOS\\": "src/"
		}
	},
	"scripts": {
		"test": "php tests/run.php",
		"test:phpunit": "phpunit",
		"acceptance": "php tests/acceptance.php",
		"lint": "find . -name '*.php' -not -path './build/dashboard-src/node_modules/*' -exec php -l {} +",
		"stan": "phpstan analyse --memory-limit=512M",
		"cs": "phpcs",
		"cs:fix": "phpcbf",
		"ci": [
			"@lint",
			"@test",
			"@test:phpunit",
			"@acceptance",
			"@stan",
			"@cs"
		]
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
