includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    # Sprint 0.3A CI foundation: this is the initial, honest baseline —
    # not the ceiling. No phpstan-baseline.neon (blanket "ignore every
    # existing error") is checked in: whatever the FIRST real run of
    # `composer run stan` reports at this level is the true starting
    # point, and CI is expected to be green against it, not against a
    # suppressed copy of it. Raise `level` in a later sprint once this
    # baseline is clean; do not add broad ignoreErrors patterns to get
    # there faster.
    level: 5

    paths:
        - src

    # AI_WP_OS_* constants are defined in ai-wordpress-os.php, which is
    # outside `paths` above and unsafe to load directly (it guards on
    # ABSPATH and boots the real plugin kernel). This stub gives
    # PHPStan just the constant *types*; see its header for why the
    # values are dummies, not copies of the real ones.
    #
    # WP_CLI / WP_CLI_Command / WP_CLI\Utils\format_items() are WP-CLI
    # runtime symbols with no stub package in require-dev; see that
    # stub's header for why they are declared here rather than ignored.
    bootstrapFiles:
        - tools/ci/phpstan-constants-stub.php
        - tools/ci/phpstan-wpcli-stub.php

    tmpDir: build/phpstan

    # CI-RUN-#1 (2026-09-08, GitHub Actions run 34181043803) failed with
    # "PHPStan worker reached configured 512M PHP memory limit" — the
    # szepeviktor/phpstan-wordpress + php-stubs/wordpress-stubs stub set
    # this project analyses against is large enough that a single worker
    # loading it can approach/exceed 512M even for this project's small
    # `src/` tree. The composer `stan` script now passes
    # --memory-limit=1G (see composer.json). ubuntu-latest runners have
    # 16G RAM and 4 cores, so phpstan's default parallelism (up to 4
    # workers here) at 1G/worker stays well within runner capacity. If a
    # future CI run still exhausts 1G, the next lever is capping
    # `parallel.maximumNumberOfProcesses` below the CPU count — not
    # raising the ceiling further or excluding source from analysis.

    # AI WordPress OS boots against real WordPress at runtime; the
    # WP function/class signatures come from php-stubs/wordpress-stubs
    # via the phpstan-wordpress extension above, not from this
    # repository's own tests/shim/ (that shim is a *test-time* WP
    # substitute and is intentionally excluded from static analysis:
    # `paths` above covers src/ only).
    treatPhpDocTypesAsCertain: false
