<?xml version="1.0"?>
<ruleset name="AI WordPress OS">
	<description>
		Sprint 0.3A CI foundation: WordPress-Extra, scoped to src/. Every
		exclusion below is a structural/architectural policy call, not a
		shortcut to hide a real finding — see each exclusion's own
		comment. Whatever the first real `composer run cs` run reports
		against this ruleset is the honest starting baseline for this
		codebase; fix findings rather than adding new exclusions to
		reach green.
	</description>

	<file>src</file>

	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>

	<rule ref="WordPress-Extra">
		<!--
			This is a Composer/PSR-4 autoloaded plugin (AIOS\ -> src/),
			not a classic WordPress includes/ tree: filenames are
			StudlyCase class names (Crypto.php, ToolExecutor.php), which
			is how every PSR-4 WordPress plugin in this style is written
			and is incompatible by construction with WP's
			class-name.php / interface-name.php file-naming sniff.
		-->
		<exclude name="WordPress.Files.FileName"/>

		<!--
			src/ is a modern OOP/PSR-4 class API (Ability, ToolExecutor,
			MutationEngine, every Catalog provider, etc.), not procedural
			WordPress includes code: method and property names are
			consistently camelCase throughout — 374 method declarations
			and 32 property declarations across 85 files, confirmed by
			direct source audit, not a handful of stragglers. Enforcing
			WP's snake_case convention on this class API would mean
			renaming the overwhelming majority of the codebase's public
			and internal surface (service container bindings, WP hook
			callback arrays referencing methods by string, MCP/REST
			call chains) purely for a naming-style sniff, with no
			security, correctness, or WordPress-compatibility benefit —
			PHP has no functional distinction between camelCase and
			snake_case identifiers. This exclusion covers ONLY the two
			naming sniffs that conflict with OOP method/property
			naming; procedural-code naming rules the project also
			follows — hook names (ValidHookName), global function/class/
			constant prefixing (PrefixAllGlobals) — remain enforced, as
			do all escaping, sanitization, SQL, capability, nonce, and
			filesystem sniffs elsewhere in WordPress-Extra.
		-->
		<exclude name="WordPress.NamingConventions.ValidFunctionName"/>
		<exclude name="WordPress.NamingConventions.ValidVariableName"/>
	</rule>

	<!--
		P2-08 policy (sprint 0.3 closeout): escaping belongs at the
		output/render boundary. AIOS exceptions are internal error
		carriers — they are caught, mapped to StructuredError codes,
		redacted, and logged via the audit trail; they are never echoed
		or rendered as HTML anywhere. Adding esc_html()/esc_attr()
		inside exception construction would corrupt error strings for
		non-HTML consumers (CLI, JSON-RPC, audit log) while providing
		zero XSS protection, because nothing renders these strings.
		The real output paths (REST/JSON-RPC responses, admin UI) are
		separately covered by the non-exception escaping sniffs, which
		remain fully enforced.
	-->
	<rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
		<exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
	</rule>

	<!--
		Structural contract: every catalog tool handler is invoked by
		ToolExecutor with the uniform signature ($args, $user) and
		every REST callback receives the WP_REST_Request object, even
		when an individual handler does not use one of them. Flagging
		those contractual parameters as dead would push handlers toward
		breaking signature uniformity (the registry relies on the
		shared shape). The remaining 99% of this code-analysis sniff —
		genuinely dead parameters in non-contract methods — stays
		enforced via targeted review; this exclusion is scoped to the
		contract pattern only.
	-->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<exclude name="Generic.CodeAnalysis.UnusedFunctionParameter"/>
	</rule>

	<!--
		The file mutation engine (src/Mutation/Operations/*,
		src/Files/FileReader) deliberately reads/writes LOCAL files
		with native PHP functions under PathGuard confinement. The
		recommended WP_Filesystem API requires filesystem credentials
		that a headless plugin cannot assume are configured, and
		wp_remote_get() is for remote URLs — it is the wrong tool for
		local reads. File operations stay native + guarded; the
		@-silencing, escaping, SQL, and path-security sniffs remain
		fully enforced.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude name="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents"/>
		<exclude name="WordPress.WP.AlternativeFunctions.file_system_operations_file_put_contents"/>
	</rule>

	<!-- Matches the plugin slug used at every __()/_e() call site in src/Admin. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ai-wordpress-os"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_supported_wp_version" value="6.0"/>
</ruleset>
